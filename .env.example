# ============================================================
# AI OUTREACH SYSTEM — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# --- ALL AGENTS ---

# Anthropic Claude API
# Get from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Telegram Bot (for approval notifications)
# Create a bot: message @BotFather on Telegram → /newbot
TELEGRAM_BOT_TOKEN=
# Your personal chat ID: message @userinfobot on Telegram
TELEGRAM_CHAT_ID=

# --- AGENT 1: LinkedIn Content Agent ---

# Taplio (optional — for LinkedIn post scheduling via official API)
# Get from: https://taplio.com → Settings → API
# Leave blank to use manual copy-paste file output instead
TAPLIO_API_KEY=

# --- AGENT 2: Lead Gen + Enrichment Engine ---

# Apollo.io (lead sourcing for client campaigns)
# Get from: https://developer.apollo.io → API Keys
APOLLO_API_KEY=

# Instantly.ai (cold email sending)
# Get from: https://app.instantly.ai → Settings → API
# Use this OR Smartlead — not both
INSTANTLY_API_KEY=

# Smartlead (alternative cold email sending)
# Get from: https://app.smartlead.ai → Settings → API
SMARTLEAD_API_KEY=

# Your dedicated cold-email sending domain
# IMPORTANT: This must be a SEPARATE domain from your main domain
# Example: if your main domain is yourbrand.com, use outreach.yourbrand.com
SENDING_DOMAIN=

# Max emails to send per inbox per day (default: 30 — do not increase without warm-up)
DAILY_SEND_CAP=30

# --- AGENT 3: Remote Job Hunter ---
# No extra keys needed — uses public APIs and RSS feeds
# (RemoteOK, WeWorkRemotely, Wellfound are free/public)
